# Copy this file to .env and fill in your actual values.

# OpenAI-compatible client pointed at the local openai-api-server-via-codex
# server (routes through your ChatGPT subscription's Codex backend).
# Start the server in a separate terminal with: uvx openai-api-server-via-codex
OPENAI_BASE_URL=http://127.0.0.1:18080/v1
OPENAI_API_KEY=dummy

# Serial port the ESP32 enumerates as on your machine, e.g. COM5 on Windows
# or /dev/ttyUSB0 on Linux.
SERIAL_PORT=COM3
