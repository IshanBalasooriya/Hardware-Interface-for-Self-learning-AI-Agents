# Copy this file to .env and fill in your actual values.

# OpenAI-compatible client pointed at the local openai-api-server-via-codex
# server (routes through your ChatGPT subscription's Codex backend).
# Start the server in a separate terminal with: uvx openai-api-server-via-codex
OPENAI_BASE_URL=http://127.0.0.1:18080/v1
OPENAI_API_KEY=dummy

# Serial port the ESP32 enumerates as on your machine, e.g. COM5 on Windows
# or /dev/ttyUSB0 on Linux.
SERIAL_PORT=COM3

# --- Architecture B: asynchronous MQTT telemetry (optional) ---------------
# Only read by Temporaral_Context_Approach/telemetry_service.py. The existing
# synchronous architecture ignores these and runs with no broker present.
# The backend subscriber connects to the broker on this machine, so 127.0.0.1
# is correct here even though the ESP32 itself must use the LAN IP (that one
# is set separately in firmware include/telemetry_config.h).
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1884
MQTT_TOPIC=hardware/telemetry/adc/+
MQTT_LOG_FILE=Temporaral_Context_Approach/logs/adc_stream.txt
